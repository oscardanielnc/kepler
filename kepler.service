[Unit]
Description=Kepler — orquestador cuantitativo multi-activo (copy-lead)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kepler-app/kepler
EnvironmentFile=/etc/kepler.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kepler-app/venv/bin/python -m kepler.orchestrator ESTABLE
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
